# .env로 복사. 실제 비밀값은 이 파일에 적지 않는다.
# 로컬 시험 클라우드. 운영 주소는 아직 정하지 않았다.
MAGO_CLOUD_URL=http://127.0.0.1:8475
MAGO_APP_ID=mago-hagwon
# 로컬 클라우드 프로그램 관리 → 앱 비밀값 만들기에서 받은 값
MAGO_APP_SECRET=
# SQLite와 서버 비밀키를 둘 폴더. 로컬 통합 시험은 저장소 밖 임시 폴더 사용.
DATA_DIR=./data
# 선택: 충분히 긴 임의 값. 없으면 DATA_DIR/server.secret 자동 생성.
# 변경하면 기존 로그인 토큰 복호화·학생 번호 조회 불가. DB와 키를 함께 백업.
SERVER_SECRET=
PORT=8476
HOST=127.0.0.1
# HTTPS로만 서비스할 때 1. 지금 로컬 HTTP 시험에서는 0.
COOKIE_SECURE=0

# nginx 앞단에서만 1. X-Forwarded-For 맨 오른쪽 IP 사용. 기본은 소켓 주소.
TRUST_PROXY=0
